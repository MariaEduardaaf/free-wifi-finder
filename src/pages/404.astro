---
// site-pages 8.7. The host serves dist/404.html for unknown routes. noindex and no canonical; no breadcrumbs or
// BreadcrumbList (DESIGN-SYSTEM 3.20), no ads, no current header item.
import Base from '../layouts/Base.astro';
import Tile from '../components/ui/Tile.astro';
import LinkRow from '../components/ui/LinkRow.astro';
import type { IconName } from '../components/ui/icons';
import cities from '../data/wifi/cities.json';
import { SITE } from '../site';

const rows: { icon: IconName; title: string; line: string; href: string }[] = [
  { icon: 'wifi', title: 'Find free WiFi', line: 'Places that offer WiFi to the public.', href: '/' },
  ...[...cities].sort((a, b) => a.name.localeCompare(b.name)).map((c) => ({ icon: 'map-pin' as IconName, title: `${c.name}, ${c.state}`, line: 'Free WiFi in this city.', href: `/${c.slug}/` })),
];
---
<Base
  title={`Page Not Found | ${SITE.name}`}
  description="The page you asked for isn’t here. Try the free WiFi finder."
  path="/404"
  noindex
>
  <div class="container notfound">
    <Tile icon="signpost" size="md" tone="neutral" />
    <h1>We can’t find that page</h1>
    <p class="lede">The link may be old, or the address may have a typo. Try the finder or a city:</p>
    <ul class="linkrows notfound__rows">{rows.map((r) => <li><LinkRow {...r} /></li>)}</ul>
    <p class="notfound__home"><a class="hit" href="/">Go to the start page</a></p>
  </div>
</Base>

<style is:global>
  /* EmptyState-style header, one column at most 40rem, left aligned (site-pages 6). */
  .notfound > * { max-width: var(--measure); }
  .notfound > .tile { display: grid; margin-bottom: var(--space-3); }
  .notfound > h1 + .lede { margin-top: var(--space-2); }
  .notfound__rows { margin-top: var(--space-5); }
  .notfound__home { margin-top: var(--space-5); }
</style>
